menu "channelstv"

config CHANNELSTV_WIFI_SSID
    string "Wi-Fi network"
    default ""
    help
        Used only while the board has no network saved yet. Leave it empty to set one over the
        USB console instead ('W' ssid TAB password).

config CHANNELSTV_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

choice CHANNELSTV_H264_DECODER
    prompt "H.264 decoder"
    default CHANNELSTV_DEC_VIDEOJET
    help
        The software decoder for the video. Both decode constrained baseline, one access unit at a time.

config CHANNELSTV_DEC_ESP_H264
    bool "esp_h264 (Espressif's tinyH264 port)"

config CHANNELSTV_DEC_VIDEOJET
    bool "VideoJet (h264bsd with PIE SIMD kernels, components/videojet)"

endchoice

config CHANNELSTV_WIFI_OUTAGE_TEST
    bool "Test hook: pretend the saved Wi-Fi is down after the next start"
    default n
    help
        Adds GET /api/wifi/outage?s=N (Web control full): the board restarts and, for N seconds
        (30..900), doesn't try to join its saved network, as if the router were off. Its Wi-Fi
        settings stay as they are, and the next start after that is normal. For testing the setup
        hotspot that opens when the board hasn't joined two minutes after start. Not for releases.

endmenu
